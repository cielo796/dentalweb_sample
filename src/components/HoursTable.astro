---
import { clinic } from '../data/clinic';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;

const shell =
  tone === 'dark'
    ? 'border-brand-700 text-brand-50'
    : 'border-brand-100 text-ink-900';
const headCell =
  tone === 'dark' ? 'bg-brand-700 text-white' : 'bg-brand-50 text-brand-800';
const bodyCell = tone === 'dark' ? 'border-brand-700' : 'border-brand-100';
const noteColor = tone === 'dark' ? 'text-brand-200' : 'text-ink-500';
---

<div>
  <table class={`w-full table-fixed border-collapse overflow-hidden rounded-xl border text-center text-sm ${shell}`}>
    <caption class="sr-only">診療時間</caption>
    <thead>
      <tr>
        <th class={`w-[6.5rem] border-b px-1 py-2 text-xs font-bold ${headCell} ${bodyCell}`}>
          診療時間
        </th>
        {
          clinic.hours.days.map((d) => (
            <th class={`border-b border-l px-1 py-2 text-xs font-bold ${headCell} ${bodyCell}`}>
              {d.day}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      <tr>
        <th class={`border-l-0 px-1 py-3 text-xs font-bold tabular-nums ${bodyCell}`}>
          {clinic.hours.time}
        </th>
        {
          clinic.hours.days.map((d) => (
            <td class={`border-l px-1 py-3 ${bodyCell}`}>
              {d.open ? (
                <span class="text-base font-bold text-brand-500" aria-label="診療">
                  ●
                </span>
              ) : (
                <span class={`text-xs ${noteColor}`} aria-label="休診">
                  休
                </span>
              )}
            </td>
          ))
        }
      </tr>
    </tbody>
  </table>

  <p class={`mt-3 text-xs leading-relaxed ${noteColor}`}>
    {clinic.hours.closedText}<br />
    {clinic.hours.note}
  </p>
</div>
