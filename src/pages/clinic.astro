---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HoursTable from '../components/HoursTable.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { clinic } from '../data/clinic';

const overview = [
  { label: '医院名', value: clinic.name },
  { label: '院長', value: `${clinic.doctor.name}（SAMPLE）` },
  { label: '所在地', value: `〒${clinic.postalCode} ${clinic.address}` },
  { label: '電話番号', value: clinic.tel },
  { label: '診療科目', value: '歯科・小児歯科' },
  { label: '診療時間', value: `${clinic.hours.time}（${clinic.hours.closedText}）` },
  { label: '駐車場', value: clinic.parking.detail },
  { label: '対応', value: '保険診療（自由診療の取り扱いはありません）' },
];
---

<BaseLayout
  title="医院紹介"
  description="飯田歯科医院の院長挨拶、院内設備、医院概要のご案内です。茨城県取手市白山、取手駅西口より徒歩8分。"
>
  <PageHero
    en="About Us"
    title="医院紹介"
    lead="地域のかかりつけ歯科医院として、ていねいな説明と無理のない治療を心がけています。"
  />

  {/* 院長挨拶 */}
  <section class="wrap py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        {/* SAMPLE: 院長写真に差し替えてください */}
        <div class="aspect-3/4 overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-100 to-brand-50">
          <div class="grid h-full place-items-center text-center">
            <div class="px-6">
              <p class="text-5xl" aria-hidden="true">👩‍⚕️</p>
              <p class="mt-3 text-sm font-bold text-brand-700">
                院長写真<span class="sample-badge ml-1">SAMPLE</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <p class="heading-en">Message</p>
        <h2 class="heading-jp text-ink-900">院長ごあいさつ</h2>

        <div class="prose-jp mt-6 text-sm leading-relaxed text-ink-700 lg:text-base">
          <p>{clinic.doctor.message}</p>
          <p>
            歯科医院は「痛くなってから行く場所」と思われがちですが、早く見つかるほど治療の負担は小さくて済みます。数か月に一度のチェックを、生活の習慣に加えていただければうれしく思います。
          </p>
        </div>

        <p class="mt-8 text-sm">
          <span class="text-xs text-ink-500">{clinic.doctor.role}</span><br />
          <span class="text-xl font-bold text-ink-900">{clinic.doctor.name}</span>
          <span class="sample-badge ml-2">SAMPLE</span>
        </p>

        <div class="mt-10">
          <h3 class="text-sm font-bold text-brand-700">
            経歴<span class="sample-badge ml-2">SAMPLE</span>
          </h3>
          <ul class="mt-4 divide-y divide-brand-100 border-t border-brand-100 text-sm">
            {
              clinic.doctor.career.map((c) => (
                <li class="flex gap-6 py-3">
                  <span class="w-20 shrink-0 text-xs font-bold text-brand-500">{c.year}</span>
                  <span class="text-ink-700">{c.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* 院内・設備 */}
  <section class="bg-brand-50/60 py-16 lg:py-24">
    <div class="wrap">
      <p class="heading-en text-center">Facility</p>
      <h2 class="heading-jp text-center text-ink-900">院内・設備</h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-sm text-ink-700">
        落ち着いた雰囲気の院内で、清潔な環境を保つよう努めています。
      </p>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          clinic.facilities.map((f) => (
            <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
              <div class="mx-auto grid h-24 w-full place-items-center rounded-xl bg-brand-50 text-3xl" aria-hidden="true">
                🪥
              </div>
              <p class="mt-4 text-sm font-bold text-ink-900">{f}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-center text-xs text-ink-500">
        ※ 設備の内容は仮のものです。実際の設備に合わせて差し替えてください。
      </p>
    </div>
  </section>

  {/* 医院概要 */}
  <section class="wrap py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
      <div>
        <p class="heading-en">Overview</p>
        <h2 class="heading-jp text-ink-900">医院概要</h2>

        <dl class="mt-8 divide-y divide-brand-100 border-t border-brand-100 text-sm">
          {
            overview.map((row) => (
              <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <dt class="text-xs font-bold text-brand-600 sm:text-sm">{row.label}</dt>
                <dd class="text-ink-700">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div>
        <p class="heading-en">Schedule</p>
        <h2 class="heading-jp text-ink-900">診療時間</h2>
        <div class="mt-8">
          <HoursTable />
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
