---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HoursTable from '../components/HoursTable.astro';
import { clinic } from '../data/clinic';

const fieldClass =
  'mt-2 w-full rounded-xl border border-brand-200 bg-white px-4 py-3 text-sm outline-none focus:border-brand-500';
---

<BaseLayout
  title="お問い合わせ"
  description="飯田歯科医院へのご予約・お問い合わせ。お電話（0297-72-2203）またはフォームよりご連絡ください。"
>
  <PageHero
    en="Contact"
    title="ご予約・お問い合わせ"
    lead="ご予約はお電話が確実です。急な痛みなど、当日のご連絡でも可能な限り対応いたします。"
  />

  {/* 電話 */}
  <section class="wrap py-16 lg:py-20">
    <div class="rounded-3xl bg-brand-600 px-6 py-12 text-center text-white lg:px-16">
      <p class="text-sm font-bold text-brand-100">お電話でのご予約・ご相談</p>
      <a
        href={clinic.telHref}
        class="mt-3 block text-4xl font-bold text-white no-underline tabular-nums lg:text-5xl"
        >{clinic.tel}</a
      >
      <p class="mt-4 text-xs text-brand-100">
        受付時間 {clinic.hours.time}／{clinic.hours.closedText}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-md">
      <HoursTable />
    </div>
  </section>

  {/* フォーム */}
  <section class="bg-brand-50/60 py-16 lg:py-24">
    <div class="wrap max-w-3xl">
      <p class="heading-en text-center">Form</p>
      <h2 class="heading-jp text-center text-ink-900">お問い合わせフォーム</h2>

      <div class="mt-6 rounded-2xl border-2 border-dashed border-accent-400 bg-white p-5 text-center">
        <p class="text-sm font-bold text-accent-600">
          このフォームは表示サンプルです<span class="sample-badge ml-2">SAMPLE</span>
        </p>
        <p class="mt-2 text-xs leading-relaxed text-ink-700">
          送信処理は未接続です。Formspree / Google フォーム / メールサーバー等の送信先を
          <code class="rounded bg-brand-50 px-1">form</code> の
          <code class="rounded bg-brand-50 px-1">action</code> に設定してください。
        </p>
      </div>

      <form class="mt-10 grid gap-6" action="#" method="post">
        <div>
          <label for="name" class="text-sm font-bold text-ink-900">
            お名前 <span class="text-xs text-red-600">必須</span>
          </label>
          <input id="name" name="name" type="text" required autocomplete="name" class={fieldClass} />
        </div>

        <div>
          <label for="tel" class="text-sm font-bold text-ink-900">
            電話番号 <span class="text-xs text-red-600">必須</span>
          </label>
          <input id="tel" name="tel" type="tel" required autocomplete="tel" class={fieldClass} />
        </div>

        <div>
          <label for="email" class="text-sm font-bold text-ink-900">メールアドレス</label>
          <input id="email" name="email" type="email" autocomplete="email" class={fieldClass} />
        </div>

        <div>
          <label for="topic" class="text-sm font-bold text-ink-900">ご用件</label>
          <select id="topic" name="topic" class={fieldClass}>
            <option>診療のご予約</option>
            <option>治療内容について</option>
            <option>定期健診について</option>
            <option>その他</option>
          </select>
        </div>

        <div>
          <label for="message" class="text-sm font-bold text-ink-900">
            お問い合わせ内容 <span class="text-xs text-red-600">必須</span>
          </label>
          <textarea id="message" name="message" rows="6" required class={fieldClass}></textarea>
        </div>

        <label class="flex items-start gap-3 text-sm text-ink-700">
          <input type="checkbox" name="agree" required class="mt-1.5" />
          <span>
            <a href="/privacy/" class="text-brand-600 underline">プライバシーポリシー</a>に同意します
          </span>
        </label>

        <div class="text-center">
          <button type="submit" class="btn btn-primary w-full sm:w-auto">送信する</button>
        </div>
      </form>

      <p class="mt-6 text-center text-xs leading-relaxed text-ink-500">
        ※ フォームからのご連絡には、数日お時間をいただく場合があります。<br />
        お急ぎの場合はお電話にてご連絡ください。
      </p>
    </div>
  </section>

  {/* FAQ */}
  <section class="wrap py-16 lg:py-24">
    <p class="heading-en text-center">FAQ</p>
    <h2 class="heading-jp text-center text-ink-900">よくあるご質問</h2>

    <div class="mx-auto mt-12 grid max-w-3xl gap-4">
      {
        clinic.faq.map((item) => (
          <details class="group rounded-2xl border border-brand-100 bg-white p-6">
            <summary class="flex cursor-pointer list-none items-start gap-3 text-sm font-bold text-ink-900">
              <span class="text-brand-500" aria-hidden="true">
                Q.
              </span>
              <span class="flex-1">{item.q}</span>
              <span class="text-brand-400 transition-transform group-open:rotate-45" aria-hidden="true">
                ＋
              </span>
            </summary>
            <div class="mt-4 flex gap-3 border-t border-brand-100 pt-4 text-sm leading-relaxed text-ink-700">
              <span class="text-accent-500 font-bold" aria-hidden="true">
                A.
              </span>
              <p class="flex-1">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
