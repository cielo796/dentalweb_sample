---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HoursTable from '../components/HoursTable.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { clinic } from '../data/clinic';

const features = [
  {
    en: 'Explain',
    title: '説明してから、治療する',
    body: '今どんな状態で、これから何をするのか。納得いただいてから処置を始めます。',
    icon: '💬',
  },
  {
    en: 'Insurance',
    title: '保険診療が基本',
    body: '自由診療は導入していません。保険の範囲でできる最善をご提案します。',
    icon: '🏥',
  },
  {
    en: 'Access',
    title: '駅から徒歩8分・駐車場あり',
    body: '取手駅西口から徒歩8分。国道294号沿いに無料駐車場を4台分ご用意しています。',
    icon: '🚗',
  },
];

const newsItems = clinic.news.slice(0, 3);
---

<BaseLayout>
  {/* ------------------------------- Hero ------------------------------- */}
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
    <div class="dot-pattern absolute inset-0 opacity-50" aria-hidden="true"></div>

    <div class="wrap relative grid gap-10 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-xs font-bold text-brand-600 shadow-sm">
          茨城県取手市白山
        </p>

        <h1 class="mt-6 text-3xl font-bold leading-[1.4] text-ink-900 sm:text-4xl lg:text-[2.75rem]">
          {clinic.catch}
        </h1>

        <p class="mt-6 max-w-xl text-sm leading-relaxed text-ink-700 lg:text-base">
          {clinic.lead}
        </p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href={clinic.telHref} class="btn btn-primary text-lg">
            <span aria-hidden="true">☎</span>
            <span class="tabular-nums">{clinic.tel}</span>
          </a>
          <a href="/treatment/" class="btn btn-outline">診療案内を見る</a>
        </div>

        <dl class="mt-10 grid max-w-lg grid-cols-2 gap-4 text-sm">
          <div class="rounded-2xl border border-brand-100 bg-white p-4">
            <dt class="text-xs font-bold text-brand-600">診療時間</dt>
            <dd class="mt-1 font-bold tabular-nums">{clinic.hours.time}</dd>
          </div>
          <div class="rounded-2xl border border-brand-100 bg-white p-4">
            <dt class="text-xs font-bold text-brand-600">休診日</dt>
            <dd class="mt-1 font-bold">木曜・日曜・祝日</dd>
          </div>
        </dl>
      </div>

      {/* SAMPLE: 写真が用意でき次第、この装飾ブロックを差し替えてください */}
      <div class="relative">
        <div class="aspect-4/3 overflow-hidden rounded-[2rem] bg-brand-100 shadow-xl">
          <div class="grid h-full w-full place-items-center bg-gradient-to-br from-brand-200 via-brand-100 to-white text-center">
            <div class="px-6">
              <p class="text-6xl" aria-hidden="true">🦷</p>
              <p class="mt-4 text-sm font-bold text-brand-700">
                医院の外観・院内写真
                <span class="sample-badge ml-1">SAMPLE</span>
              </p>
              <p class="mt-1 text-xs text-brand-600">
                public/images/ に画像を置いて差し替えてください
              </p>
            </div>
          </div>
        </div>

        <div class="absolute -bottom-6 -left-4 hidden rounded-2xl bg-white px-5 py-4 shadow-lg sm:block lg:-left-10">
          <p class="text-xs text-ink-500">無料駐車場</p>
          <p class="text-lg font-bold text-brand-700">4台完備</p>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------- Features ----------------------------- */}
  <section class="wrap py-16 lg:py-24">
    <SectionHeading en="Features" title="当院について" align="center" />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        features.map((f) => (
          <article class="rounded-3xl border border-brand-100 bg-white p-8 transition-shadow hover:shadow-lg">
            <p class="text-4xl" aria-hidden="true">
              {f.icon}
            </p>
            <p class="mt-4 text-[0.625rem] font-bold tracking-[0.22em] text-brand-400 uppercase">
              {f.en}
            </p>
            <h3 class="mt-2 text-lg font-bold text-ink-900">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-700">{f.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------- Treatments ---------------------------- */}
  <section class="bg-brand-50/60 py-16 lg:py-24">
    <div class="wrap">
      <SectionHeading en="Treatment" title="診療案内" align="center" />

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          clinic.treatments.map((t) => (
            <article class="flex h-full flex-col rounded-2xl bg-white p-7 shadow-sm">
              <h3 class="text-base font-bold text-brand-700">{t.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-700">{t.summary}</p>
              <a
                href={`/treatment/#${t.slug}`}
                class="mt-5 inline-flex items-center gap-1 text-xs font-bold text-brand-600 no-underline hover:gap-2"
              >
                くわしく見る<span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="mt-10 text-center">
        <a href="/treatment/" class="btn btn-outline">診療案内をすべて見る</a>
      </p>
    </div>
  </section>

  {/* -------------------------- Hours / Access -------------------------- */}
  <section class="wrap py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading en="Schedule" title="診療時間" />
        <div class="mt-8">
          <HoursTable />
        </div>

        <div class="mt-8 rounded-2xl bg-brand-50 p-6">
          <p class="text-sm font-bold text-brand-700">ご予約について</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-700">
            お電話でのご予約をおすすめしています。急な痛みなど、当日のご連絡でも可能な限り対応いたします。
          </p>
          <a
            href={clinic.telHref}
            class="mt-4 inline-block text-2xl font-bold text-brand-700 no-underline tabular-nums"
            >{clinic.tel}</a
          >
        </div>
      </div>

      <div>
        <SectionHeading en="Access" title="アクセス" />

        <div class="mt-8 overflow-hidden rounded-2xl border border-brand-100">
          <iframe
            src={clinic.mapEmbedUrl}
            title={`${clinic.name}の地図`}
            width="100%"
            height="280"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <dl class="mt-6 grid gap-4 text-sm">
          <div>
            <dt class="text-xs font-bold text-brand-600">所在地</dt>
            <dd class="mt-1">〒{clinic.postalCode} {clinic.address}</dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-brand-600">最寄り</dt>
            <dd class="mt-1">
              <ul class="grid gap-1">
                {clinic.access.map((a) => <li>{a.label}より{a.detail}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-brand-600">駐車場</dt>
            <dd class="mt-1">{clinic.parking.detail}</dd>
          </div>
        </dl>

        <p class="mt-6">
          <a href="/access/" class="btn btn-outline text-sm">アクセス詳細</a>
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------ Voices ------------------------------ */}
  <section class="bg-brand-50/60 py-16 lg:py-24">
    <div class="wrap">
      <SectionHeading en="Voice" title="患者さまの声" align="center" />

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          clinic.voices.map((v) => (
            <figure class="rounded-3xl bg-white p-8 shadow-sm">
              <p class="text-xs font-bold text-accent-600" aria-hidden="true">
                ★★★★★
              </p>
              <figcaption class="mt-3 text-base font-bold text-ink-900">{v.title}</figcaption>
              <blockquote class="mt-3 text-sm leading-relaxed text-ink-700">{v.body}</blockquote>
              <p class="mt-4 text-[0.6875rem] text-ink-500">{v.meta}</p>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------- News ------------------------------- */}
  <section class="wrap py-16 lg:py-24">
    <div class="grid gap-8 lg:grid-cols-[auto_1fr] lg:gap-16">
      <SectionHeading en="News" title="お知らせ" />

      <ul class="divide-y divide-brand-100 border-t border-brand-100">
        {
          newsItems.map((n) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6">
              <time datetime={n.date} class="text-xs font-bold text-brand-500 tabular-nums">
                {n.date.replaceAll('-', '.')}
              </time>
              <p class="text-sm text-ink-700">{n.title}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
